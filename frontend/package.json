{
  "name": "truthhub-bd",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:attachments && npm run test:i18n && npm run test:locations && npm run test:videos && npm run test:ads && node --experimental-strip-types --test tests/auth-return-path.test.mjs tests/discovery-params.test.mjs tests/organization-image-submission.test.mjs tests/public-media.test.mjs tests/notification-content.test.mjs tests/alert-feed-order.test.mjs",
    "test:attachments": "node --experimental-strip-types --test tests/attachments.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n-content.test.mjs",
    "test:locations": "node --test tests/bd-locations.test.mjs",
    "test:videos": "node --experimental-strip-types --test tests/public-video-urls.test.mjs",
    "test:ads": "node --experimental-strip-types --test tests/advertisements.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "framer-motion": "13.4.6",
    "lucide-react": "^0.542.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.4.6",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "TruthHubBD"
}
